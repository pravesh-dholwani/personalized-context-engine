ENVIRONMENT=development
PORT=8000
LOG_LEVEL=info

# Upstream Service Endpoints
# NOTE: the plan's illustrative ports (8001-8004) collided with services
# already running on this machine (e.g. Redis Insight on 8001) - shifted to
# the 9101-9104 range to avoid clobbering an unrelated local service.
USER_SERVICE_URL=http://localhost:9101/users
KUNDLI_SERVICE_URL=http://localhost:9102/kundli
HOROSCOPE_SERVICE_URL=http://localhost:9103/horoscope
PANCHANG_SERVICE_URL=http://localhost:9104/panchang

# Resiliency & Performance
HTTP_TIMEOUT_SECONDS=2.0
HTTP_MAX_RETRIES=2
CACHE_TTL_SECONDS=300

# API Keys
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=   # unused in this pass - reserved for a future provider
